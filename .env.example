# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clé service_role : SERVEUR UNIQUEMENT (création des comptes de la rédaction).
# Ne jamais la préfixer par NEXT_PUBLIC_ ni la committer.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL publique du site (sitemap, liens de partage, balises Open Graph)
NEXT_PUBLIC_SITE_URL=https://nenoactu.cd
